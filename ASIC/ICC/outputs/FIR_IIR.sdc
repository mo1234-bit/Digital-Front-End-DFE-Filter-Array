###################################################################

# Created by write_sdc on Fri Dec  6 04:12:48 2019

###################################################################
set sdc_version 1.9

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current mA
set_max_transition 1 [current_design]
create_clock [get_ports clk]  -period 6  -waveform {0 3}
set_clock_uncertainty 0.35  [get_clocks clk]
create_clock [get_ports clk_1]  -period 18  -waveform {0 9}
set_clock_uncertainty 0.35  [get_clocks clk_1]
set_input_delay -clock clk  -max 2  [get_ports rst_n]
set_input_delay -clock clk  -min 0.5  [get_ports rst_n]
set_input_delay -clock clk  -max 2  [get_ports {D[5]}]
set_input_delay -clock clk  -min 0.5  [get_ports {D[5]}]
